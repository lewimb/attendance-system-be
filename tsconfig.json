{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    // "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    // "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node",
      "multer"
    ],
    "paths": {
      "@app/common": [
        "./libs/common/src/index.ts"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/attendance-system/tsconfig.app.json"
    },
    {
      "path": "./apps/employee-service/tsconfig.app.json"
    },
    {
      "path": "./apps/attendance-service/tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}